{
  "properties": {
    "page": {
      "type": "object",
      "properties": {
        "size": {
          "type": "string",
          "enum": [
            "a4",
            "a5",
            "us-letter",
            "us-executive"
          ],
          "default": "us-letter",
          "description": "The page size. Use 'a4' (international standard) or 'us-letter' (US standard). The default value is `us-letter`."
        },
        "top_margin": {
          "type": "string",
          "default": "0.7in",
          "description": "It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0.7in`.",
          "format": "dimension"
        },
        "bottom_margin": {
          "type": "string",
          "default": "0.7in",
          "description": "It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0.7in`.",
          "format": "dimension"
        },
        "left_margin": {
          "type": "string",
          "default": "0.7in",
          "description": "It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0.7in`.",
          "format": "dimension"
        },
        "right_margin": {
          "type": "string",
          "default": "0.7in",
          "description": "It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0.7in`.",
          "format": "dimension"
        },
        "show_footer": {
          "type": "boolean",
          "default": true,
          "description": "Show the footer at the bottom of pages. The default value is `true`."
        },
        "show_top_note": {
          "type": "boolean",
          "default": true,
          "description": "Show the top note at the top of the first page. The default value is `true`."
        }
      }
    },
    "colors": {
      "type": "object",
      "properties": {
        "body": {
          "type": "string",
          "default": "rgb(0, 0, 0)",
          "description": "The color can be specified either with their name (https://www.w3.org/TR/SVG11/types.html#ColorKeywords), hexadecimal value, RGB value, or HSL value. The default value is `rgb(0, 0, 0)`.",
          "format": "color"
        },
        "name": {
          "type": "string",
          "default": "rgb(0, 79, 144)",
          "description": "The color can be specified either with their name (https://www.w3.org/TR/SVG11/types.html#ColorKeywords), hexadecimal value, RGB value, or HSL value. The default value is `rgb(0, 79, 144)`.",
          "format": "color"
        },
        "headline": {
          "type": "string",
          "default": "rgb(0, 79, 144)",
          "description": "The color can be specified either with their name (https://www.w3.org/TR/SVG11/types.html#ColorKeywords), hexadecimal value, RGB value, or HSL value. The default value is `rgb(0, 79, 144)`.",
          "format": "color"
        },
        "connections": {
          "type": "string",
          "default": "rgb(0, 79, 144)",
          "description": "The color can be specified either with their name (https://www.w3.org/TR/SVG11/types.html#ColorKeywords), hexadecimal value, RGB value, or HSL value. The default value is `rgb(0, 79, 144)`.",
          "format": "color"
        },
        "section_titles": {
          "type": "string",
          "default": "rgb(0, 79, 144)",
          "description": "The color can be specified either with their name (https://www.w3.org/TR/SVG11/types.html#ColorKeywords), hexadecimal value, RGB value, or HSL value. The default value is `rgb(0, 79, 144)`.",
          "format": "color"
        },
        "links": {
          "type": "string",
          "default": "rgb(0, 79, 144)",
          "description": "The color can be specified either with their name (https://www.w3.org/TR/SVG11/types.html#ColorKeywords), hexadecimal value, RGB value, or HSL value. The default value is `rgb(0, 79, 144)`.",
          "format": "color"
        },
        "footer": {
          "type": "string",
          "default": "rgb(128, 128, 128)",
          "description": "The color can be specified either with their name (https://www.w3.org/TR/SVG11/types.html#ColorKeywords), hexadecimal value, RGB value, or HSL value. The default value is `rgb(128, 128, 128)`.",
          "format": "color"
        },
        "top_note": {
          "type": "string",
          "default": "rgb(128, 128, 128)",
          "description": "The color can be specified either with their name (https://www.w3.org/TR/SVG11/types.html#ColorKeywords), hexadecimal value, RGB value, or HSL value. The default value is `rgb(128, 128, 128)`.",
          "format": "color"
        }
      }
    },
    "typography": {
      "type": "object",
      "properties": {
        "line_spacing": {
          "type": "string",
          "default": "0.6em",
          "description": "Space between lines of text. Larger values create more vertical space. The default value is `0.6em`.",
          "format": "dimension"
        },
        "alignment": {
          "type": "string",
          "enum": [
            "left",
            "justified",
            "justified-with-no-hyphenation"
          ],
          "default": "justified",
          "description": "Text alignment. Options: 'left', 'justified' (spreads text across full width), 'justified-with-no-hyphenation' (justified without word breaks). The default value is `justified`."
        },
        "date_and_location_column_alignment": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "default": "right",
          "description": "Alignment for dates and locations in entries. Options: 'left', 'center', 'right'. The default value is `right`."
        },
        "font_family": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string",
              "default": "Source Sans 3",
              "description": "The font family for body text. The default value is `Source Sans 3`."
            },
            "name": {
              "type": "string",
              "default": "Source Sans 3",
              "description": "The font family for the name. The default value is `Source Sans 3`."
            },
            "headline": {
              "type": "string",
              "default": "Source Sans 3",
              "description": "The font family for the headline. The default value is `Source Sans 3`."
            },
            "connections": {
              "type": "string",
              "default": "Source Sans 3",
              "description": "The font family for connections. The default value is `Source Sans 3`."
            },
            "section_titles": {
              "type": "string",
              "default": "Source Sans 3",
              "description": "The font family for section titles. The default value is `Source Sans 3`."
            }
          },
          "description": "The font family. You can provide a single font name as a string (applies to all elements), or a dictionary with keys 'body', 'name', 'headline', 'connections', and 'section_titles' to customize each element. Any system font can be used."
        },
        "font_size": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string",
              "default": "10pt",
              "description": "The font size for body text. The default value is `10pt`.",
              "format": "dimension"
            },
            "name": {
              "type": "string",
              "default": "30pt",
              "description": "The font size for the name. The default value is `30pt`.",
              "format": "dimension"
            },
            "headline": {
              "type": "string",
              "default": "10pt",
              "description": "The font size for the headline. The default value is `10pt`.",
              "format": "dimension"
            },
            "connections": {
              "type": "string",
              "default": "10pt",
              "description": "The font size for connections. The default value is `10pt`.",
              "format": "dimension"
            },
            "section_titles": {
              "type": "string",
              "default": "1.4em",
              "description": "The font size for section titles. The default value is `1.4em`.",
              "format": "dimension"
            }
          },
          "description": "Font sizes for different elements."
        },
        "small_caps": {
          "type": "object",
          "properties": {
            "name": {
              "type": "boolean",
              "default": false,
              "description": "Whether to use small caps for the name. The default value is `false`."
            },
            "headline": {
              "type": "boolean",
              "default": false,
              "description": "Whether to use small caps for the headline. The default value is `false`."
            },
            "connections": {
              "type": "boolean",
              "default": false,
              "description": "Whether to use small caps for connections. The default value is `false`."
            },
            "section_titles": {
              "type": "boolean",
              "default": false,
              "description": "Whether to use small caps for section titles. The default value is `false`."
            }
          },
          "description": "Small caps styling for different elements."
        },
        "bold": {
          "type": "object",
          "properties": {
            "name": {
              "type": "boolean",
              "default": true,
              "description": "Whether to make the name bold. The default value is `true`."
            },
            "headline": {
              "type": "boolean",
              "default": false,
              "description": "Whether to make the headline bold. The default value is `false`."
            },
            "connections": {
              "type": "boolean",
              "default": false,
              "description": "Whether to make connections bold. The default value is `false`."
            },
            "section_titles": {
              "type": "boolean",
              "default": true,
              "description": "Whether to make section titles bold. The default value is `true`."
            }
          },
          "description": "Bold styling for different elements."
        }
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "underline": {
          "type": "boolean",
          "default": false,
          "description": "Underline hyperlinks. The default value is `false`."
        },
        "show_external_link_icon": {
          "type": "boolean",
          "default": false,
          "description": "Show an external link icon next to URLs. The default value is `false`."
        }
      }
    },
    "header": {
      "type": "object",
      "properties": {
        "alignment": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "default": "center",
          "description": "Header alignment. Options: 'left', 'center', 'right'. The default value is `center`."
        },
        "photo_width": {
          "type": "string",
          "default": "3.5cm",
          "description": "Photo width. It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `3.5cm`.",
          "format": "dimension"
        },
        "photo_position": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "left",
          "description": "Photo position (left or right). The default value is `left`."
        },
        "photo_space_left": {
          "type": "string",
          "default": "0.4cm",
          "description": "Space to the left of the photo. It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0.4cm`.",
          "format": "dimension"
        },
        "photo_space_right": {
          "type": "string",
          "default": "0.4cm",
          "description": "Space to the right of the photo. It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0.4cm`.",
          "format": "dimension"
        },
        "space_below_name": {
          "type": "string",
          "default": "0.7cm",
          "description": "Space below your name. It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0.7cm`.",
          "format": "dimension"
        },
        "space_below_headline": {
          "type": "string",
          "default": "0.7cm",
          "description": "Space below the headline. It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0.7cm`.",
          "format": "dimension"
        },
        "space_below_connections": {
          "type": "string",
          "default": "0.7cm",
          "description": "Space below contact information. It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0.7cm`.",
          "format": "dimension"
        },
        "connections": {
          "type": "object",
          "properties": {
            "phone_number_format": {
              "type": "string",
              "enum": [
                "national",
                "international",
                "E164"
              ],
              "default": "national",
              "description": "Phone number format. The default value is `national`."
            },
            "hyperlink": {
              "type": "boolean",
              "default": true,
              "description": "Make contact information clickable in the PDF. The default value is `true`."
            },
            "show_icons": {
              "type": "boolean",
              "default": true,
              "description": "Show icons next to contact information. The default value is `true`."
            },
            "display_urls_instead_of_usernames": {
              "type": "boolean",
              "default": false,
              "description": "Display full URLs instead of labels. The default value is `false`."
            },
            "separator": {
              "type": "string",
              "default": "",
              "description": "Character(s) to separate contact items (e.g., '|' or '•'). Leave empty for no separator. The default value is `''`."
            },
            "space_between_connections": {
              "type": "string",
              "default": "0.5cm",
              "description": "Horizontal space between contact items. It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0.5cm`.",
              "format": "dimension"
            }
          },
          "description": "Contact information settings."
        }
      }
    },
    "section_titles": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "with_partial_line",
            "with_full_line",
            "without_line",
            "moderncv",
            "centered_without_line",
            "centered_with_partial_line",
            "centered_with_centered_partial_line",
            "centered_with_full_line"
          ],
          "default": "with_partial_line",
          "description": "Section title visual style. Use 'with_partial_line' for a line next to the title, 'with_full_line' for a line across the page, 'without_line' for no line, 'moderncv' for the ModernCV style, 'centered_without_line' for a centered title with no line, 'centered_with_partial_line' for a centered title with baseline partial lines on both sides, 'centered_with_centered_partial_line' for a centered title with middle-aligned lines on both sides, or 'centered_with_full_line' for a full-width line underneath. The default value is `with_partial_line`."
        },
        "line_thickness": {
          "type": "string",
          "default": "0.5pt",
          "description": "It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0.5pt`.",
          "format": "dimension"
        },
        "space_above": {
          "type": "string",
          "default": "0.5cm",
          "description": "It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0.5cm`.",
          "format": "dimension"
        },
        "space_below": {
          "type": "string",
          "default": "0.3cm",
          "description": "It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0.3cm`.",
          "format": "dimension"
        }
      }
    },
    "sections": {
      "type": "object",
      "properties": {
        "allow_page_break": {
          "type": "boolean",
          "default": true,
          "description": "Allow page breaks within sections. If false, sections that don't fit will start on a new page. The default value is `true`."
        },
        "space_between_regular_entries": {
          "type": "string",
          "default": "1.2em",
          "description": "Vertical space between entries. It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `1.2em`.",
          "format": "dimension"
        },
        "space_between_text_based_entries": {
          "type": "string",
          "default": "0.3em",
          "description": "Vertical space between text-based entries. It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0.3em`.",
          "format": "dimension"
        },
        "show_time_spans_in": {
          "type": "array",
          "default": [
            "experience"
          ],
          "description": "Section titles where time spans (e.g., '2 years 3 months') should be displayed. The default value is `['experience']`.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "entries": {
      "type": "object",
      "properties": {
        "date_and_location_width": {
          "type": "string",
          "default": "4.15cm",
          "description": "Width of the date/location column. It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `4.15cm`.",
          "format": "dimension"
        },
        "side_space": {
          "type": "string",
          "default": "0.2cm",
          "description": "Left and right margins. It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0.2cm`.",
          "format": "dimension"
        },
        "space_between_columns": {
          "type": "string",
          "default": "0.1cm",
          "description": "Space between main content and date/location columns. It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0.1cm`.",
          "format": "dimension"
        },
        "allow_page_break": {
          "type": "boolean",
          "default": false,
          "description": "Allow page breaks within entries. If false, entries that don't fit will move to a new page. The default value is `false`."
        },
        "short_second_row": {
          "type": "boolean",
          "default": true,
          "description": "Shorten the second row to align with the date/location column. The default value is `true`."
        },
        "degree_width": {
          "type": "string",
          "default": "1cm",
          "description": "Width of the degree column. It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `1cm`.",
          "format": "dimension"
        },
        "summary": {
          "type": "object",
          "properties": {
            "space_above": {
              "type": "string",
              "default": "0cm",
              "description": "Space above summary text. It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0cm`.",
              "format": "dimension"
            },
            "space_left": {
              "type": "string",
              "default": "0cm",
              "description": "Left margin for summary text. It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0cm`.",
              "format": "dimension"
            }
          },
          "description": "Summary text settings."
        },
        "highlights": {
          "type": "object",
          "properties": {
            "bullet": {
              "type": "string",
              "enum": [
                "●",
                "•",
                "◦",
                "-",
                "◆",
                "★",
                "■",
                "—",
                "○"
              ],
              "default": "•",
              "description": "Bullet character for highlights. The default value is `•`."
            },
            "nested_bullet": {
              "type": "string",
              "enum": [
                "●",
                "•",
                "◦",
                "-",
                "◆",
                "★",
                "■",
                "—",
                "○"
              ],
              "default": "•",
              "description": "Bullet character for nested highlights. The default value is `•`."
            },
            "space_left": {
              "type": "string",
              "default": "0.15cm",
              "description": "Left indentation. It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0.15cm`.",
              "format": "dimension"
            },
            "space_above": {
              "type": "string",
              "default": "0cm",
              "description": "Space above highlights. It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0cm`.",
              "format": "dimension"
            },
            "space_between_items": {
              "type": "string",
              "default": "0cm",
              "description": "Space between highlight items. It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0cm`.",
              "format": "dimension"
            },
            "space_between_bullet_and_text": {
              "type": "string",
              "default": "0.5em",
              "description": "Space between bullet and text. It can be specified with units (cm, in, pt, mm, em). For example, `0.1cm`. The default value is `0.5em`.",
              "format": "dimension"
            }
          },
          "description": "Highlights settings."
        }
      }
    }
  },
