---
import Ai from '../Ai.vue';
import Career from '../Career.vue';
import CareerJob from '../CareerJob.vue';
import CareerSettings from '../CareerSettings.vue';
import Reading from '../Reading.vue';
import ReadingSettings from '../ReadingSettings.vue';
import ReadingLibrary from '../ReadingLibrary.vue';
import ReadingNotebooks from '../ReadingNotebooks.vue';
import ReadingRoom from '../ReadingRoom.vue';
import ReadingVault from '../ReadingVault.vue';
import ReadingVaultNote from '../ReadingVaultNote.vue';
import Collection from '../Collection.vue';
import Cv from '../Cv.vue';
import CvStyles from '../CvStyles.vue';
import Editor from '../Editor.vue';
import Dashboard from '../Dashboard.vue';
import Login from '../Login.vue';
import Media from '../Media.vue';
import Pages from '../Pages.vue';
import PostEditor from '../PostEditor.vue';
import Posts from '../Posts.vue';
import Settings from '../Settings.vue';
import Users from '../Users.vue';
import yaml from 'js-yaml';
import Favicon from '../../components/astro/Favicon.astro';
import { getSiteConfig } from '../../lib/config';
import { loadSiteFiles } from '../../lib/content/context';
import { getSql } from '../../lib/db';
import { getMode } from '../../lib/mode';
import type { SiteConfig } from '../../lib/types';
import { readConfig } from '../../lib/admin/content';
import { getStore } from '../../lib/admin/get-store';
import { authorOf } from '../../lib/admin/http';
import { adminSettings, canPublish, isOwner } from '../../lib/admin/settings';
import '../../themes/editorial/editorial.css';
import '../admin.css';

const { adminPath, siteName } = adminSettings();
const [screen = '', arg = '', sub = '', ...rest] = (Astro.params.path ?? '').split('/');
const SCREENS = new Set([
  '',
  'login',
  'media',
  'posts',
  'publications',
  'content',
  'cv',
  'cv-styles',
  'pages',
  'settings',
  'users',
  'ai',
  'editor',
  'career',
  'reading',
]);
const CONTENT = ['announcements', 'people', 'projects', 'talks', 'positions'];
if (!SCREENS.has(screen)) return new Response('Not found', { status: 404 });
if (screen === 'content' && !CONTENT.includes(arg)) return new Response('Not found', { status: 404 });
if (screen === 'users' && getMode() !== 'postgres') return new Response('Not found', { status: 404 });
if (
  screen === 'career' &&
  (getMode() !== 'postgres' ||
    !Astro.locals.user ||
    !isOwner(Astro.locals.user, adminSettings()) ||
    (arg && arg !== 'settings' && !/^\d+$/.test(arg)))
)
  return new Response('Not found', { status: 404 });
if (
  screen === 'reading' &&
  (getMode() !== 'postgres' ||
    !Astro.locals.user ||
    !isOwner(Astro.locals.user, adminSettings()) ||
    rest.length > 0 ||
    !(
      ((!arg || ['settings', 'library', 'notebooks', 'vault'].includes(arg)) && !sub) ||
      (['papers', 'notebooks', 'vault'].includes(arg) && /^\d{1,9}$/.test(sub)) ||
      (arg === 'vault' && sub === 'graph')
    ))
)
  return new Response('Not found', { status: 404 });
if (screen === 'cv-styles' && getMode() === 'static') return new Response('Not found', { status: 404 });

// The post editor's "Import to Medium" needs the public site URL. Read from the store like the medium API route, so
// it is current in both modes (git: GitHub; Postgres: the database, where site.yml lives); unreadable → the editor
// falls back to its own origin.
const user = Astro.locals.user;
let siteUrl = '';
if (screen === 'posts' && arg && user) {
  try {
    siteUrl = String((await readConfig(getStore(authorOf(user)), 'site')).data.siteUrl ?? '');
  } catch {
    // the editor still opens; its API calls report the store error
  }
}
const mode = getMode();
// Admin pages render outside the public request context, so Postgres mode reads the favicon from the database here.
let favicon: string | undefined;
try {
  favicon =
    mode === 'postgres'
      ? (yaml.load((await loadSiteFiles(getSql())).get('config/site.yml') ?? '') as SiteConfig | null)?.favicon
      : getSiteConfig().favicon;
} catch {
  // the built-in icons
}
const ctx = {
  adminPath,
  siteName,
  user: user ?? null,
  mode,
  canPublish: !!user && canPublish(user, adminSettings()),
  isOwner: !!user && isOwner(user, adminSettings()),
  mediumToken: !!process.env.MEDIUM_TOKEN,
  siteUrl,
};
const LOGIN_ERRORS: Record<string, string> = {
  denied: "That GitHub account isn't on this site's admin list (adminUsers in config/site.yml).",
  expired: 'Sign-in expired or was interrupted. Please try again.',
};
const error = Astro.url.searchParams.get('error');
const githubLogin = mode !== 'postgres' || !!(process.env.GITHUB_CLIENT_ID && process.env.GITHUB_CLIENT_SECRET);
const loginError = error ? (Object.hasOwn(LOGIN_ERRORS, error) ? LOGIN_ERRORS[error] : LOGIN_ERRORS.expired) : '';
if (screen === 'login' && error === 'denied') Astro.response.status = 403;
---

<!doctype html>
<html lang="en" data-theme="editorial">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Site admin · {siteName}</title>
    <Favicon favicon={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono&family=IBM+Plex+Sans:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
    />
  </head>
  <body class="adm">
    {screen === 'login' && (
      <Login
        client:only="vue"
        adminPath={adminPath}
        siteName={siteName}
        password={mode === 'postgres'}
        github={githubLogin}
        error={loginError}
      />
    )}
    {screen === 'media' && <Media client:only="vue" ctx={ctx} />}
    {screen === 'pages' && <Pages client:only="vue" ctx={ctx} />}
    {screen === 'settings' && <Settings client:only="vue" ctx={ctx} />}
    {screen === 'ai' && <Ai client:only="vue" ctx={ctx} />}
    {screen === 'editor' && <Editor client:only="vue" ctx={ctx} />}
    {screen === 'users' && <Users client:only="vue" ctx={ctx} />}
    {screen === 'career' && !arg && <Career client:only="vue" ctx={ctx} />}
    {screen === 'career' && arg === 'settings' && <CareerSettings client:only="vue" ctx={ctx} />}
    {screen === 'career' && /^\d+$/.test(arg) && <CareerJob client:only="vue" ctx={ctx} id={arg} />}
    {screen === 'reading' && !arg && <Reading client:only="vue" ctx={ctx} />}
    {screen === 'reading' && arg === 'settings' && <ReadingSettings client:only="vue" ctx={ctx} />}
    {screen === 'reading' && arg === 'library' && <ReadingLibrary client:only="vue" ctx={ctx} />}
    {screen === 'reading' && arg === 'notebooks' && !sub && <ReadingNotebooks client:only="vue" ctx={ctx} />}
    {screen === 'reading' && arg === 'papers' && <ReadingRoom client:only="vue" ctx={ctx} paper={sub} />}
    {screen === 'reading' && arg === 'notebooks' && sub && <ReadingRoom client:only="vue" ctx={ctx} notebook={sub} />}
    {screen === 'reading' && arg === 'vault' && !sub && <ReadingVault client:only="vue" ctx={ctx} />}
    {screen === 'reading' && arg === 'vault' && /^\d+$/.test(sub) && (
      <ReadingVaultNote client:only="vue" ctx={ctx} id={sub} />
    )}
    {screen === 'cv' && <Cv client:only="vue" ctx={ctx} />}
    {screen === 'cv-styles' && <CvStyles client:only="vue" ctx={ctx} />}
    {screen === '' && <Dashboard client:only="vue" ctx={ctx} />}
    {screen === 'posts' && !arg && <Posts client:only="vue" ctx={ctx} />}
    {screen === 'posts' && arg && <PostEditor client:only="vue" ctx={ctx} slug={arg} />}
    {screen === 'publications' && <Collection client:only="vue" ctx={ctx} name="publications" />}
    {screen === 'content' && <Collection client:only="vue" ctx={ctx} name={arg} />}
  </body>
</html>
