---
import ClassicBlogTag from '../../../themes/classic/BlogTag.astro';
import EditorialBlogTag from '../../../themes/editorial/BlogTag.astro';
import { getTheme } from '../../../lib/config';
import { getEntries, staticProps } from '../../../lib/content';
import { slugify } from '../../../lib/utils';

export async function getStaticPaths() {
  const posts = await getEntries('posts');
  const allTags = [...new Set(posts.flatMap((p) => p.data.tags || []))];

  return allTags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags?.includes(tag))
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

const props = await staticProps(Astro, getStaticPaths);
if (!props) return new Response(null, { status: 404 });
const { tag, posts } = props;
---

{getTheme() === 'editorial' ? <EditorialBlogTag {tag} {posts} /> : <ClassicBlogTag {tag} {posts} />}
