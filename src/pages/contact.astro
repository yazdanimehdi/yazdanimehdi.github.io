---
import ClassicContact from '../themes/classic/Contact.astro';
import EditorialContact from '../themes/editorial/Contact.astro';
import { getSiteConfig, getSiteName, getTheme, isPersonalMode } from '../lib/config';

const config = getSiteConfig();
const siteName = getSiteName();
const personal = isPersonalMode();
const web3formsKey = config.web3forms?.accessKey;
const ContactPage = getTheme() === 'editorial' ? EditorialContact : ClassicContact;
---

<ContactPage {config} {siteName} {personal} {web3formsKey} />
