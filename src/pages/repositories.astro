---
import ClassicRepositories from '../themes/classic/Repositories.astro';
import EditorialRepositories from '../themes/editorial/Repositories.astro';
import { getSiteConfig, getTheme, isPersonalMode } from '../lib/config';
import { getEntries } from '../lib/content';
import { readSiteFile } from '../lib/content/context';
import { GITHUB_JSON, parseSnapshot, summarize, type GitHubRepo } from '../lib/github';
import { getRoleName, extractGitHubUsername, formatShortDate } from '../lib/utils';

const config = getSiteConfig();
const personal = isPersonalMode();
const github = config.github;

if (!github) {
  return Astro.redirect('/');
}

const { username, stats, trophies, showPinnedRepos = true, pinnedRepos } = github;

const statsBase = (github.statsBaseUrl ?? 'https://github-readme-stats.vercel.app').replace(/\/$/, '');
const trophyBase = (github.trophyBaseUrl ?? 'https://github-profile-trophy.vercel.app').replace(/\/$/, '');

const statsUrl = (user: string, theme: string) => `${statsBase}/api?username=${user}&show_icons=true&theme=${theme}`;
const langsUrl = (user: string, theme: string) =>
  `${statsBase}/api/top-langs/?username=${user}&layout=compact&theme=${theme}`;
const repoUrl = (user: string, repo: string, theme: string) =>
  `${statsBase}/api/pin/?username=${user}&repo=${repo}&theme=${theme}`;
const trophyUrl = (theme: string) => `${trophyBase}/?username=${username}&theme=${theme}&no-frame=true&column=-1`;

const lightTheme = 'default';
const darkTheme = 'github_dark';

// Get all active people who have a GitHub link
const members = (await getEntries('people'))
  .filter((p) => p.data.active && p.data.socials?.github)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .map((p) => ({
    name: p.data.name,
    role: p.data.role,
    title: p.data.title,
    id: p.id,
    githubUsername: extractGitHubUsername(p.data.socials!.github!),
    githubUrl: p.data.socials!.github!,
  }))
  .filter((m) => m.githubUsername !== null);

// Journal theme: GitHub's own numbers from the daily snapshot (src/data/github.json), drawn in the site's type. Without
// a snapshot yet, the stats fall back to the card images. A pinned repo takes its description from the project whose
// repoUrl points at it, then from GitHub.
const shot = (url: (theme: string) => string, alt: string) => ({ light: url(lightTheme), dark: url(darkTheme), alt });
const editorial = getTheme() === 'editorial';
const projects = editorial ? await getEntries('projects') : [];
const snapshot = editorial ? parseSnapshot(readSiteFile(GITHUB_JSON), username) : null;
const pinned = showPinnedRepos !== false ? (pinnedRepos ?? []) : [];
const summary = snapshot ? summarize(snapshot, pinned) : null;
const describe = (r: GitHubRepo) => ({
  name: r.name,
  href: r.url,
  description: r.description ?? undefined,
  language: r.language ?? undefined,
  stars: r.stars,
  forks: r.forks,
  topics: r.topics,
  updated: formatShortDate(r.pushedAt, config.lang),
  updatedIso: r.pushedAt,
});
const journal = {
  personal,
  username,
  stats:
    stats && !summary
      ? [shot((t) => statsUrl(username, t), 'GitHub Stats'), shot((t) => langsUrl(username, t), 'Top Languages')]
      : [],
  glance: trophies && summary ? summary.totals : undefined,
  languages: stats && summary ? summary.languages : [],
  recent: stats && summary ? summary.recent.map(describe) : [],
  repos: pinned.map((repo) => {
    const href = `https://github.com/${username}/${repo}`;
    const project = projects.find((p) => p.data.repoUrl?.replace(/\/+$/, '').toLowerCase() === href.toLowerCase());
    const live = summary?.pinned.find((r) => r.name.toLowerCase() === repo.toLowerCase());
    const base = live ? describe(live) : { name: repo, href, topics: [] as string[] };
    return { ...base, description: project?.data.excerpt ?? (live?.description || undefined) };
  }),
  members: personal
    ? []
    : members.map((m) => ({
        ...m,
        caption: m.title || getRoleName(m.role),
        stats: [
          shot((t) => statsUrl(m.githubUsername!, t), `${m.name} GitHub Stats`),
          shot((t) => langsUrl(m.githubUsername!, t), `${m.name} Top Languages`),
        ],
      })),
};
---

{editorial ? (
  <EditorialRepositories {...journal} />
) : (
  <ClassicRepositories
    {personal}
    {username}
    {stats}
    {trophies}
    {showPinnedRepos}
    {pinnedRepos}
    {members}
    {statsUrl}
    {langsUrl}
    {repoUrl}
    {trophyUrl}
    {lightTheme}
    {darkTheme}
  />
)}
