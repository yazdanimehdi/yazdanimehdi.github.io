---
import ClassicPeople from '../../themes/classic/People.astro';
import EditorialPeople from '../../themes/editorial/People.astro';
import { getEntries } from '../../lib/content';
import { getRoleGroup } from '../../lib/utils';
import { getTheme, isPersonalMode } from '../../lib/config';

const personal = isPersonalMode();

const people = (await getEntries('people')).sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const groups: Record<string, typeof people> = {};
for (const person of people) {
  const group = person.data.active ? getRoleGroup(person.data.role) : 'Alumni';
  if (!groups[group]) groups[group] = [];
  groups[group].push(person);
}

const tabOrder = ['Faculty', 'Researchers', 'Students', 'Alumni'];

const currentMembers = [...(groups['Faculty'] || []), ...(groups['Researchers'] || []), ...(groups['Students'] || [])];
const alumni = groups['Alumni'] || [];
const orderedGroups = tabOrder.filter((t) => groups[t]?.length).map((name) => ({ name, people: groups[name] }));
---

{
  getTheme() === 'editorial' ? (
    <EditorialPeople {personal} groups={orderedGroups} />
  ) : (
    <ClassicPeople {personal} {currentMembers} {alumni} />
  )
}
