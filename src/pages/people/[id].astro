---
import ClassicPerson from '../../themes/classic/Person.astro';
import EditorialPerson from '../../themes/editorial/Person.astro';
import { getEntries, staticProps } from '../../lib/content';
import { readSiteFile } from '../../lib/content/context';
import { resolveImage } from '../../lib/content/image';
import { getTheme } from '../../lib/config';
import { byId } from '../../lib/utils';

export async function getStaticPaths() {
  const people = await getEntries('people');
  return people.map((person) => ({
    params: { id: person.id },
    props: { person },
  }));
}

const props = await staticProps(Astro, getStaticPaths);
if (!props) return new Response(null, { status: 404 });
const { person } = props;

const publications = (await getEntries('publications'))
  .sort(byId)
  .filter((p) =>
    p.data.authors.some((a) => a.toLowerCase().includes(person.data.name.split(' ')[1]?.toLowerCase() || '')),
  )
  .sort((a, b) => b.data.year - a.data.year);

const projects = (await getEntries('projects')).filter((p) => p.data.team?.includes(person.id));

let personCvMeta: Record<string, { pdfPath: string }> = {};
try {
  personCvMeta = JSON.parse(readSiteFile('src/data/cv-people.json') ?? '{}');
} catch {}
const cvInfo = personCvMeta[person.id] ?? null;

let ogImage: string | undefined;
if (person.data.photo) {
  const resolved = await resolveImage(person.data.photo, 1200);
  ogImage = resolved.src;
}
const Person = getTheme() === 'editorial' ? EditorialPerson : ClassicPerson;
---

<Person {person} {publications} {projects} {cvInfo} {ogImage} />
