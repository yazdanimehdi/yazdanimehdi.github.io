---
import { resolveImage } from '../../lib/content/image';

interface Props {
  /** The favicon from Settings → Identity, if one was uploaded. */
  favicon?: string;
}

// An uploaded favicon serves the tab and the home screen; without one, the icons in public/. SVG and ICO are linked
// as uploaded: image optimizers do not resize them. iOS takes no ICO, so the home screen keeps the built-in icon.
const { favicon } = Astro.props;
const asUploaded = favicon && /\.(svg|ico)(\?|$)/i.test(favicon);
const ico = favicon && /\.ico(\?|$)/i.test(favicon);
const sized = async (src: string, width: number) => (asUploaded ? src : (await resolveImage(src, width)).src);
const icon = favicon
  ? { tab: await sized(favicon, 64), touch: ico ? '/apple-touch-icon.png' : await sized(favicon, 180) }
  : null;
---

{icon ? (
  <>
    <link rel="icon" href={icon.tab} />
    <link rel="apple-touch-icon" href={icon.touch} />
  </>
) : (
  <>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </>
)}
