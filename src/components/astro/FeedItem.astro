---
import { formatNewsDate, safeHref } from '../../lib/utils';
import { getSiteConfig } from '../../lib/config';
import { uiStrings } from '../../lib/ui-strings';

interface Props {
  title: string;
  link: string;
  date: string;
  source: string;
  excerpt?: string;
  author?: string;
}

const { title, link, date, source, excerpt } = Astro.props;
const config = getSiteConfig();
const parsed = new Date(date);
const shownDate = Number.isNaN(parsed.getTime()) ? date : formatNewsDate(parsed, 'day', config.lang);
---

{/* The whole card is clickable through the title link's stretched ::after; the link's name stays the title. */}
<article class="group relative border-b border-surface-100 py-3 last:border-b-0 dark:border-dm-border">
  <h3 class="text-sm leading-snug font-medium" dir="auto">
    <a
      href={safeHref(link)}
      target="_blank"
      rel="noopener noreferrer"
      class="text-surface-900 transition-colors group-hover:text-primary-600 after:absolute after:inset-0 dark:text-dm-heading dark:group-hover:text-accent-400"
    >
      {title}
      <span class="whitespace-nowrap">
        &nbsp;
        <svg
          class="inline h-3 w-3 align-baseline text-surface-500 dark:text-dm-muted"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
        <span class="sr-only"> {uiStrings(config)('a11y.newTab')}</span>
      </span>
    </a>
  </h3>
  {excerpt && (
    <p dir="auto" class="mt-1 line-clamp-2 text-xs text-surface-500 dark:text-dm-muted">
      {excerpt}
    </p>
  )}
  <div class="mt-1 flex items-center gap-2 text-xs text-surface-500 dark:text-dm-muted">
    <span>{source}</span>
    <span aria-hidden="true">&middot;</span>
    <time datetime={Number.isNaN(parsed.getTime()) ? undefined : parsed.toISOString()}>{shownDate}</time>
  </div>
</article>
