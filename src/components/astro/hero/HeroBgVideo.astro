---
import type { HeroVideoConfig } from '../../../lib/types';

interface Props {
  video: HeroVideoConfig;
}

const { video } = Astro.props;
---

<video
  data-hero-video
  muted
  loop
  playsinline
  preload="none"
  width="1920"
  height="600"
  class="absolute inset-0 h-full w-full object-cover"
  poster={video.poster || undefined}
>
  <source src={video.src} type="video/mp4" />
</video>

{/* Overlay for text readability */}
<div class="absolute inset-0 bg-white/60 dark:bg-dm/70"></div>

<script>
  // Autoplay only when motion is welcome; otherwise the poster stays.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const v of document.querySelectorAll<HTMLVideoElement>('[data-hero-video]')) v.play().catch(() => {});
  }
</script>
