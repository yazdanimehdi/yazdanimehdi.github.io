---
import { patternStyle } from '../../../lib/hero-patterns';
import type { HeroPatternConfig, HeroModeConfig } from '../../../lib/types';

interface Props {
  pattern: HeroPatternConfig;
  light: HeroModeConfig;
  dark: HeroModeConfig;
}

const { pattern, light, dark } = Astro.props;
const style = patternStyle(pattern, { ink: 'var(--hero-ink)', accent: 'var(--hero-accent)' });
---

{/* Light mode base color */}
<div class="absolute inset-0 dark:hidden" style={`background-color: ${light.bgColor};`}></div>
{/* Dark mode base color */}
<div class="absolute inset-0 hidden dark:block" style={`background-color: ${dark.bgColor};`}></div>
{/* Pattern overlay */}
<div class:list={['hero-pattern absolute inset-0', { 'hero-pattern--full': pattern.fade === false }]} {style}></div>
