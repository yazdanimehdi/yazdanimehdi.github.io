---
import { getSiteConfig } from '../../lib/config';
import HeroBgImage from './hero/HeroBgImage.astro';
import HeroBgVideo from './hero/HeroBgVideo.astro';
import HeroBgPattern from './hero/HeroBgPattern.astro';
import HeroBgAnimation from '../vue/HeroBgAnimation.vue';
import { getImageShapeClass } from '../../lib/imageShape';
import { uiStrings } from '../../lib/ui-strings';

interface Link {
  text: string;
  href: string;
}

interface Props {
  title: string;
  /** Role · institution, shown under the name. */
  role?: string;
  /** One-sentence research focus. */
  focus?: string;
  portrait?: { src: string; alt: string };
  /** Scholarly profile links (Scholar, ORCID, GitHub), one quiet text row under the focus. */
  profiles?: { label: string; href: string }[];
  primary?: Link;
  /** Outline actions after the primary. */
  secondary?: Link[];
}

const { title, role, focus, portrait, profiles = [], primary, secondary = [] } = Astro.props;

const config = getSiteConfig();
const t = uiStrings(config);
const hero = config.hero ?? {
  type: 'none' as const,
  light: { bgColor: '#ffffff' },
  dark: { bgColor: '#0d1117' },
};

const lightBg = hero.light?.bgColor ?? '#ffffff';
const darkBg = hero.dark?.bgColor ?? '#0d1117';
---

<section
  class="relative overflow-hidden border-b border-surface-200 dark:border-dm-border"
  style={`--hero-bg-light: ${lightBg}; --hero-bg-dark: ${darkBg};`}
>
  {/* Background layer */}
  <div class="absolute inset-0 z-0">
    {
      hero.type === 'none' && (
        <>
          <div class="absolute inset-0 dark:hidden" style={`background-color: ${lightBg};`} />
          <div class="absolute inset-0 hidden dark:block" style={`background-color: ${darkBg};`} />
        </>
      )
    }

    {hero.type === 'image' && <HeroBgImage light={hero.light} dark={hero.dark} />}

    {hero.type === 'video' && hero.video && <HeroBgVideo video={hero.video} />}

    {
      hero.type === 'pattern' && hero.pattern && (
        <HeroBgPattern name={hero.pattern.name} light={hero.light} dark={hero.dark} />
      )
    }

    {
      hero.type === 'animation' && hero.animation && (
        <HeroBgAnimation
          client:only="vue"
          preset={hero.animation.preset}
          customScript={hero.animation.customScript || undefined}
          lightBgColor={lightBg}
          darkBgColor={darkBg}
        />
      )
    }
  </div>

  {/* Foreground content */}
  <div
    class="relative z-10 mx-auto flex max-w-[930px] flex-col gap-6 px-4 py-12 sm:px-6 sm:py-16 md:flex-row md:items-center md:gap-10"
  >
    {
      portrait && (
        <img
          src={portrait.src}
          alt={portrait.alt}
          width="176"
          height="176"
          class:list={['h-32 w-32 shrink-0 object-cover sm:h-44 sm:w-44 md:order-last', getImageShapeClass()]}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )
    }
    {/* Without a portrait the actions take the end column on md+, so the hero's second half carries them. */}
    <div
      class:list={[
        'min-w-0 flex-1',
        !portrait && (primary || secondary.length > 0) && 'md:grid md:grid-cols-[1fr_auto] md:items-end md:gap-x-10',
      ]}
    >
      <h1
        dir="auto"
        class="font-serif text-3xl leading-tight font-normal text-balance text-surface-900 sm:text-4xl lg:text-[2.75rem] dark:text-dm-heading"
      >
        {title}
      </h1>
      {
        role && (
          <p dir="auto" class="mt-3 text-base font-medium text-surface-700 dark:text-dm-text">
            {role}
          </p>
        )
      }
      {
        focus && (
          <p dir="auto" class="mt-4 max-w-2xl text-base leading-relaxed text-surface-600 sm:text-lg dark:text-dm-muted">
            {focus}
          </p>
        )
      }
      {
        profiles.length > 0 && (
          <ul aria-label={t('home.profiles')} class="mt-2 flex flex-wrap gap-x-5 text-sm">
            {profiles.map((l) => (
              <li>
                <a
                  href={l.href}
                  rel="noopener noreferrer"
                  class="inline-flex min-h-11 items-center text-primary-600 underline-offset-2 hover:underline dark:text-accent-400"
                >
                  <bdi>{l.label}</bdi>
                  <span class="sr-only">{` ${t('link.external')}`}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
      {
        (primary || secondary.length > 0) && (
          <div
            class:list={[
              'mt-6 flex flex-wrap gap-3',
              !portrait && 'md:col-start-2 md:row-span-4 md:row-start-1 md:mt-0 md:flex-col md:items-stretch',
            ]}
          >
            {primary && (
              <a
                href={primary.href}
                class="inline-flex min-h-11 items-center justify-center rounded bg-primary-600 px-4 text-sm font-medium text-white transition-colors hover:bg-primary-700 dark:bg-accent-600 dark:text-dm dark:hover:bg-accent-500"
              >
                {primary.text}
              </a>
            )}
            {secondary.map((l) => (
              <a
                href={l.href}
                class="inline-flex min-h-11 items-center justify-center rounded border border-surface-300 px-4 text-sm font-medium text-surface-700 transition-colors hover:border-surface-400 hover:text-surface-900 dark:border-dm-border-alt dark:text-dm-text dark:hover:border-[#8b949e] dark:hover:text-white"
              >
                {l.text}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
