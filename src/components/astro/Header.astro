---
import Nav from './Nav.astro';
import ThemeToggle from '../vue/ThemeToggle.vue';
import MobileNav from '../vue/MobileNav.vue';
import SearchDialog from '../vue/SearchDialog.vue';
import { getSiteConfig, getSiteName } from '../../lib/config';
import { headerLogo } from '../../lib/content/image';
import { splitNav } from '../../lib/editorial';
import { getSearchItems } from '../../lib/search';
import { uiStrings } from '../../lib/ui-strings';

const config = getSiteConfig();
const siteName = getSiteName();
const logo = config.logo ? await headerLogo(config.logo) : null;
const searchItems = await getSearchItems();
const t = uiStrings(config);
// Same cap as the journal header: six links by site-mode priority, Contact pinned; the rest go to the footer.
const nav = splitNav(config.nav, config.siteMode, Astro.url.pathname);
const searchLabels = {
  search: t('search.label'),
  placeholder: t('search.placeholder'),
  prompt: t('search.prompt'),
  empty: t('search.empty'),
  browse: t('search.browse'),
  close: t('search.close'),
};
const themeLabels = {
  label: t('mode.label'),
  byDefault: t('mode.default'),
  words: { light: t('mode.light'), dark: t('mode.dark') },
};
const menuLabels = {
  open: t('menu.open'),
  title: t('menu.title'),
  close: t('menu.close'),
  dialog: t('menu.label'),
  primary: t('nav.primary'),
  more: t('nav.more'),
};
---

<header
  class="w-full border-b border-surface-200 bg-white/95 backdrop-blur-sm max-md:sticky max-md:top-0 max-md:z-40 dark:border-dm-border dark:bg-dm/95"
>
  <div class="mx-auto max-w-[930px] px-4 sm:px-6">
    <div class="flex min-h-16 items-center justify-between gap-4">
      <a
        href="/"
        class="flex min-w-0 items-center gap-2 py-2 text-base leading-tight font-medium break-words text-surface-900 transition-colors hover:text-primary-600 md:me-2 md:shrink-0 md:whitespace-nowrap dark:text-dm-heading dark:hover:text-accent-400"
        aria-current={Astro.url.pathname === '/' ? 'page' : undefined}
      >
        {
          logo && (
            <img
              src={logo.src}
              alt=""
              width={logo.width}
              height="28"
              class:list={['h-7 w-auto shrink-0 object-contain', logo.ink && 'dark:invert']}
            />
          )
        }
        <span class="min-w-0">{siteName}</span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden min-w-0 items-center gap-1 md:flex" data-nav-desktop>
        <Nav items={nav.primary} contact={nav.contact} />
        <SearchDialog
          client:only="vue"
          items={searchItems}
          labels={searchLabels}
          pages={[...nav.primary, ...(nav.contact ? [nav.contact] : [])]}
        />
        {/* pe-1.5 holds the toggle's 44px hit area inside the row, which Nav measures for overflow. */}
        <div class="ms-2 border-s border-surface-200 ps-2 pe-1.5 dark:border-dm-border">
          <ThemeToggle client:only="vue" labels={themeLabels} />
        </div>
      </div>

      <!-- Mobile: search + theme toggle + hamburger -->
      {/* 44px targets drawn at 32px: each button's negative margin is half of the gap between them. */}
      <div class="flex shrink-0 items-center gap-3 md:hidden">
        <button
          id="mobile-search-btn"
          type="button"
          class="-m-1.5 inline-flex h-11 w-11 items-center justify-center text-surface-500 transition-colors hover:text-surface-700 dark:text-dm-muted dark:hover:text-dm-text"
          aria-label={searchLabels.search}
        >
          <svg
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </button>
        <ThemeToggle client:only="vue" labels={themeLabels} />
        <MobileNav
          client:only="vue"
          primary={[...nav.primary, ...(nav.contact ? [nav.contact] : [])]}
          more={nav.more}
          currentPath={Astro.url.pathname}
          labels={menuLabels}
        />
      </div>
    </div>
  </div>
</header>

<script>
  document.getElementById('mobile-search-btn')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('open-search'));
  });
</script>
