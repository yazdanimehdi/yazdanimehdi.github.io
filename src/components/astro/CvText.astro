---
import { CV_FONTS, parseInline } from '../../lib/cv-inline';

interface Props {
  text?: string | number;
  linkClass?: string;
}

const { text = '', linkClass = 'ul' } = Astro.props;
const spans = parseInline(String(text));
---

{
  spans.map(({ text, bold, italic, font, href }) => {
    const plain = italic ? <em>{text}</em> : text;
    const strong = bold ? <strong>{plain}</strong> : plain;
    const styled = font ? <span style={`font-family: ${CV_FONTS[font].css}`}>{strong}</span> : strong;
    return href ? (
      <a href={href} class={linkClass} rel="noopener">
        {styled}
      </a>
    ) : (
      styled
    );
  })
}
