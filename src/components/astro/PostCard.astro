---
import { formatNewsDate } from '../../lib/utils';
import { getSiteConfig } from '../../lib/config';

interface Props {
  id: string;
  title: string;
  date: Date;
  excerpt?: string;
  tags?: string[];
  author?: string;
}

const { id, title, date, excerpt, tags } = Astro.props;
---

{/* The whole card is clickable through the title link's stretched ::after; the link's name stays the title. */}
<article class="group relative border-b border-surface-100 py-3 last:border-b-0 dark:border-dm-border">
  <h3 class="text-sm leading-snug font-medium" dir="auto">
    <a
      href={`/blog/${id}`}
      class="text-surface-900 transition-colors group-hover:text-primary-600 after:absolute after:inset-0 dark:text-dm-heading dark:group-hover:text-accent-400"
    >
      {title}
    </a>
  </h3>
  {
    excerpt && (
      <p dir="auto" class="mt-1 line-clamp-2 text-xs text-surface-500 dark:text-dm-muted">
        {excerpt}
      </p>
    )
  }
  <div class="mt-1 flex items-center gap-2 text-xs text-surface-500 dark:text-dm-muted">
    <time datetime={date.toISOString()}>{formatNewsDate(date, 'day', getSiteConfig().lang)}</time>
    {
      tags && tags.length > 0 && (
        <>
          <span aria-hidden="true">&middot;</span>
          <span>{tags[0]}</span>
        </>
      )
    }
  </div>
</article>
