---
import { getSiteConfig, getTheme } from '../../lib/config';
import { cssValue } from '../../lib/utils';

const config = getSiteConfig();
const fonts = config.fonts;
const theme = getTheme();

// Defaults matching global.css @theme values
const defaultFamilies = {
  sans: 'Roboto',
  serif: 'Roboto Slab',
  mono: 'Roboto Mono',
};

// Editorial defaults, used for any family fonts.families leaves unset
const editorialFamilies = {
  sans: 'IBM Plex Sans',
  serif: 'Source Serif 4',
  mono: 'IBM Plex Mono',
};
const themeFamilies = theme === 'editorial' ? editorialFamilies : defaultFamilies;

// Axes the editorial design uses (italic + 600). Only requested for these families, because
// Google Fonts rejects the whole stylesheet if a family lacks a requested axis value.
const editorialAxes: Record<string, string> = {
  'Source Serif 4': 'ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400',
  'IBM Plex Sans': 'wght@400;500;600',
};

const defaultSizes = {
  base: '1rem',
  sm: '0.875rem',
  lg: '1.125rem',
  h1: '2rem',
  h2: '1.5rem',
  h3: '1.25rem',
};

// Config values end up inside a <style>.
const families = {
  sans: cssValue(fonts?.families?.sans || themeFamilies.sans),
  serif: cssValue(fonts?.families?.serif || themeFamilies.serif),
  mono: cssValue(fonts?.families?.mono || themeFamilies.mono),
};

const sizes = {
  base: cssValue(fonts?.sizes?.base || defaultSizes.base),
  sm: cssValue(fonts?.sizes?.sm || defaultSizes.sm),
  lg: cssValue(fonts?.sizes?.lg || defaultSizes.lg),
  h1: cssValue(fonts?.sizes?.h1 || defaultSizes.h1),
  h2: cssValue(fonts?.sizes?.h2 || defaultSizes.h2),
  h3: cssValue(fonts?.sizes?.h3 || defaultSizes.h3),
};

// Build Google Fonts URL
const uniqueFamilies = [...new Set([families.sans, families.serif, families.mono])];
const fontParams = uniqueFamilies
  .map((family) => {
    const encoded = family.replace(/ /g, '+');
    if (theme === 'editorial' && editorialAxes[family]) return `family=${encoded}:${editorialAxes[family]}`;
    // Mono fonts get fewer weights
    if (family === families.mono && family !== families.sans && family !== families.serif) {
      return `family=${encoded}:wght@400;500`;
    }
    return `family=${encoded}:wght@300;400;500;700`;
  })
  .join('&');
// Arabic-script sites also get Vazirmatn, the first face of global.css's --font-script. It sits after the
// Latin family in every stack, so its files load only for Arabic-script text.
const arabicScript = ['ar', 'fa', 'ur', 'ps', 'ckb', 'sd', 'ug'].includes(
  (config.lang ?? 'en').toLowerCase().split('-')[0],
);
const scriptParam = arabicScript && !uniqueFamilies.includes('Vazirmatn') ? '&family=Vazirmatn:wght@400;500;700' : '';
// Editorial: `optional` keeps the fallback instead of swapping late, which shifted every
// block below the hero (CLS ~0.32 in Lighthouse); cached fonts are used on later visits.
const fontDisplay = theme === 'editorial' ? 'optional' : 'swap';
const googleFontsUrl = `https://fonts.googleapis.com/css2?${fontParams}${scriptParam}&display=${fontDisplay}`;

// Font family stacks, matching global.css: Latin face, a Latin-only fallback, the Arabic-script slot, generics.
// With font-display optional the fallback is what a cold load shows, so Latin names stay serif in the serif slot.
const sansFallback =
  "'Helvetica Neue', var(--font-script, ui-sans-serif), ui-sans-serif, system-ui, -apple-system, sans-serif";
const serifFallback = 'Georgia, var(--font-script, ui-serif), ui-serif, serif';
const monoFallback = 'ui-monospace, monospace';

// Check if any value differs from defaults
const hasFamilyOverrides =
  families.sans !== defaultFamilies.sans ||
  families.serif !== defaultFamilies.serif ||
  families.mono !== defaultFamilies.mono;

const hasSizeOverrides =
  sizes.base !== defaultSizes.base ||
  sizes.sm !== defaultSizes.sm ||
  sizes.lg !== defaultSizes.lg ||
  sizes.h1 !== defaultSizes.h1 ||
  sizes.h2 !== defaultSizes.h2 ||
  sizes.h3 !== defaultSizes.h3;

// Build CSS override block
let cssOverrides = '';

if (hasFamilyOverrides || hasSizeOverrides) {
  let rootProps = '';
  if (hasFamilyOverrides) {
    rootProps += `  --font-sans: "${families.sans}", ${sansFallback};\n`;
    rootProps += `  --font-serif: "${families.serif}", ${serifFallback};\n`;
    rootProps += `  --font-mono: "${families.mono}", ${monoFallback};\n`;
  }
  if (rootProps) {
    cssOverrides += `:root {\n${rootProps}}\n`;
  }
}

if (hasSizeOverrides) {
  if (sizes.base !== defaultSizes.base) {
    cssOverrides += `body { font-size: ${sizes.base}; }\n`;
    cssOverrides += `.prose { font-size: ${sizes.base}; }\n`;
  }
  if (sizes.h1 !== defaultSizes.h1) {
    cssOverrides += `.prose h1 { font-size: ${sizes.h1}; }\n`;
  }
  if (sizes.h2 !== defaultSizes.h2) {
    cssOverrides += `.prose h2 { font-size: ${sizes.h2}; }\n`;
  }
  if (sizes.h3 !== defaultSizes.h3) {
    cssOverrides += `.prose h3 { font-size: ${sizes.h3}; }\n`;
  }
}
---

<!-- Font loading (non-render-blocking) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preload" as="style" href={googleFontsUrl} />
<link href={googleFontsUrl} rel="stylesheet" media="print" onload="this.media='all'" />
<noscript>
  <link href={googleFontsUrl} rel="stylesheet" />
</noscript>

{cssOverrides && <style set:html={cssOverrides} />}
