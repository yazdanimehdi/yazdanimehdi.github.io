---
import { formatNewsDate, type DatePrecision } from '../../lib/utils';
import { getSiteConfig } from '../../lib/config';
import { uiStrings } from '../../lib/ui-strings';

interface Props {
  id: string;
  title: string;
  date: Date;
  datePrecision?: DatePrecision;
  category: string;
  excerpt?: string;
  pinned?: boolean;
}

const { id, title, date, datePrecision, pinned } = Astro.props;
const config = getSiteConfig();
const t = uiStrings(config);
---

{/* The title comes first in the source so the link's name starts with it; the date is drawn first. */}
<a href={`/news/${id}`} class="group flex min-h-11 items-baseline gap-4 py-3">
  <span class="min-w-0 flex-1 text-sm leading-snug">
    <span
      dir="auto"
      class="font-medium text-surface-900 transition-colors group-hover:text-primary-600 dark:text-dm-heading dark:group-hover:text-accent-400"
    >
      {title}
    </span>
    {pinned && <span class="ms-2 text-xs text-primary-600 dark:text-accent-400">{t('news.pinned')}</span>}
  </span>
  <time
    datetime={date.toISOString().slice(0, 10)}
    class="order-first w-20 shrink-0 text-xs text-surface-500 tabular-nums dark:text-dm-muted"
  >
    {formatNewsDate(date, datePrecision, config.lang)}
  </time>
</a>
