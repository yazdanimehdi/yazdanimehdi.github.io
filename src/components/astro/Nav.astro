---
import { getSiteConfig } from '../../lib/config';
import { uiStrings } from '../../lib/ui-strings';
import type { NavItem } from '../../lib/types';

interface Props {
  items: NavItem[];
  /** Kept in view after the overflow menu. */
  contact?: NavItem;
}

const { items, contact } = Astro.props;
const t = uiStrings(getSiteConfig());
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
const linkClass = (href: string) => [
  'inline-flex min-h-11 items-center px-2.5 text-sm whitespace-nowrap transition-colors',
  isActive(href)
    ? 'font-medium text-primary-600 dark:text-accent-400'
    : 'text-surface-600 hover:text-primary-600 dark:text-dm-muted dark:hover:text-accent-400',
];
---

<nav class="relative flex items-center gap-0.5" aria-label={t('nav.primary')} data-nav-overflow>
  {items.map((item) => (
    <a
      href={item.href}
      class:list={linkClass(item.href)}
      aria-current={isActive(item.href) ? 'page' : undefined}
      data-nav-item
    >
      {item.label}
    </a>
  ))}

  <!-- Disclosure for the links that don't fit; filled by the script below -->
  <div class="relative hidden" data-nav-more>
    <button
      type="button"
      class="flex min-h-11 items-center gap-1 px-2.5 text-sm whitespace-nowrap text-surface-600 transition-colors hover:text-primary-600 dark:text-dm-muted dark:hover:text-accent-400"
      data-nav-more-btn
      aria-expanded="false"
      aria-controls="nav-more-list"
    >
      {t('nav.moreButton')}
      <svg
        class="h-3.5 w-3.5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M19 9l-7 7-7-7"></path>
      </svg>
    </button>
    <ul
      id="nav-more-list"
      class="absolute end-0 top-full z-50 hidden min-w-[160px] rounded-md border border-surface-200 bg-white py-1 shadow-lg dark:border-dm-border-alt dark:bg-dm-alt"
      data-nav-more-menu
    ></ul>
  </div>

  {contact && (
    <a
      href={contact.href}
      class:list={linkClass(contact.href)}
      aria-current={isActive(contact.href) ? 'page' : undefined}
    >
      {contact.label}
    </a>
  )}
</nav>

<script>
  // Links that don't fit the header row move, from the end, into the "More" disclosure. Overflow is read
  // from the row's scrollWidth, so it holds in either direction (LTR or RTL).
  function setupOverflow(container: HTMLElement) {
    if (container.hasAttribute('data-nav-initialized')) return;
    container.setAttribute('data-nav-initialized', '');

    const row = container.closest<HTMLElement>('[data-nav-desktop]');
    const more = container.querySelector<HTMLElement>('[data-nav-more]');
    const button = container.querySelector<HTMLButtonElement>('[data-nav-more-btn]');
    const menu = container.querySelector<HTMLElement>('[data-nav-more-menu]');
    const items = Array.from(container.querySelectorAll<HTMLAnchorElement>('[data-nav-item]'));
    if (!row || !more || !button || !menu || items.length === 0) return;

    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      button.setAttribute('aria-expanded', String(open));
    };
    const overflows = () => row.scrollWidth > row.clientWidth + 1;

    function measure() {
      setOpen(false);
      menu!.replaceChildren();
      items.forEach((item) => (item.style.display = ''));
      more!.classList.add('hidden');
      if (!overflows()) return;
      more!.classList.remove('hidden');
      const moved: HTMLAnchorElement[] = [];
      for (let i = items.length - 1; i >= 0 && overflows(); i--) {
        items[i].style.display = 'none';
        moved.unshift(items[i]);
      }
      for (const item of moved) {
        const link = item.cloneNode(true) as HTMLAnchorElement;
        link.style.display = '';
        link.classList.remove('inline-flex', 'px-2.5');
        link.classList.add('flex', 'px-3', 'hover:bg-surface-50', 'dark:hover:bg-dm-hover');
        link.removeAttribute('data-nav-item');
        const li = document.createElement('li');
        li.append(link);
        menu!.append(li);
      }
    }

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    container.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || button.getAttribute('aria-expanded') !== 'true') return;
      setOpen(false);
      button.focus();
    });
    container.addEventListener('focusout', (e) => {
      if (!container.contains(e.relatedTarget as Node | null)) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (!container.contains(e.target as Node)) setOpen(false);
    });

    // Re-measure when the row resizes: window resize, web fonts, and the search and theme islands hydrating.
    let frame = 0;
    new ResizeObserver(() => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(measure);
    }).observe(row);
    measure();
  }

  const init = () => document.querySelectorAll<HTMLElement>('[data-nav-overflow]').forEach(setupOverflow);
  init();
  document.addEventListener('astro:after-swap', init);
</script>
