---
import { getSiteConfig } from '../../lib/config';
import { uiStrings } from '../../lib/ui-strings';

/* Drawn arrow for standalone arrow columns, in ModeToggle's 1.5px stroke. `.arr` nudges it and mirrors it in RTL. */
interface Props {
  /** ↗ for links that leave the site, → otherwise. */
  external?: boolean;
}

const { external = false } = Astro.props;
---

<svg class="arr ed-arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
  {external ? (
    <path
      d="M5 11 11 5M6 5h5v5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  ) : (
    <path
      d="M3 8h10M9 4l4 4-4 4"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  )}
</svg>
{external && <span class="ed-sr-only">{uiStrings(getSiteConfig())('link.external')}</span>}
