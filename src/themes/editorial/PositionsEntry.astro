---
import type { CollectionEntry } from 'astro:content';
import EntryBody from '../../components/astro/EntryBody.astro';
import ApplicationForm from '../../components/vue/ApplicationForm.vue';
import Layout from './Layout.astro';
import { getSiteConfig } from '../../lib/config';
import { formatNewsDate } from '../../lib/utils';
import './timeline.css';

interface Props {
  position: CollectionEntry<'positions'>;
  contactEmail: string;
  web3formsKey?: string;
  formatType: (type: string) => string;
}

const { position, contactEmail, web3formsKey, formatType } = Astro.props;
const { title, excerpt, status, type, deadline, tags } = position.data;
const label = getSiteConfig().nav.find((n) => n.href === '/positions')?.label ?? 'Positions';
const isOpen = status === 'open';
const mailto = contactEmail ? `mailto:${contactEmail}` : undefined;
---

<Layout title={title} description={excerpt}>
  <article class="ed-article">
    <a href="/positions" class="ed-back">← {label}</a>
    <header class="ed-article-head">
      <h1 class="ed-article-title">{title}</h1>
      {excerpt && <p class="ed-subtitle">{excerpt}</p>}
    </header>

    <dl class="ed-tl-facts">
      <div>
        <dt>Type</dt>
        <dd>{formatType(type)}</dd>
      </div>
      <div>
        <dt>Status</dt>
        <dd>{isOpen ? 'Open' : 'Closed'}</dd>
      </div>
      {
        deadline && (
          <div>
            <dt>Deadline</dt>
            <dd class="num">
              <time datetime={deadline.toISOString()}>{formatNewsDate(deadline, 'day')}</time>
            </dd>
          </div>
        )
      }
      {
        tags && tags.length > 0 && (
          <div>
            <dt>Topics</dt>
            <dd>{tags.join(' · ')}</dd>
          </div>
        )
      }
      {
        isOpen && (web3formsKey || mailto) && (
          <div>
            <dt>How to apply</dt>
            <dd>
              {web3formsKey ? (
                <a href="#apply" class="ul">
                  Use the application form below
                </a>
              ) : (
                <a href={mailto} class="ul">
                  {contactEmail}
                </a>
              )}
            </dd>
          </div>
        )
      }
    </dl>

    <div class="ed-prose"><EntryBody entry={position} /></div>

    {
      isOpen && (
        <section id="apply" class="ed-tl-apply" aria-labelledby="apply-title">
          <h2 id="apply-title">Apply for this position</h2>
          {web3formsKey ? (
            <div class="ed-tl-form">
              <ApplicationForm
                client:visible
                positionTitle={title}
                contactEmail={contactEmail}
                accessKey={web3formsKey}
              />
            </div>
          ) : (
            <>
              <p>
                To apply for this position, please email{' '}
                {mailto ? (
                  <a href={mailto} class="ul">
                    {contactEmail}
                  </a>
                ) : (
                  'us'
                )}{' '}
                with your CV and research interests.
              </p>
              {mailto && (
                <a href={mailto} class="ed-btn">
                  Email your application
                </a>
              )}
            </>
          )}
        </section>
      )
    }

    {
      !isOpen && (
        <section class="ed-tl-apply">
          <p>
            This position is currently closed.
            {mailto && (
              <>
                {' '}
                For general inquiries, please contact{' '}
                <a href={mailto} class="ul">
                  {contactEmail}
                </a>
                .
              </>
            )}
          </p>
        </section>
      )
    }
  </article>
</Layout>
