---
import ObfuscatedEmail from '../../components/astro/ObfuscatedEmail.astro';
import Layout from './Layout.astro';
import { getSiteConfig } from '../../lib/config';
import './timeline.css';

interface Props {
  personal: boolean;
}

const { personal } = Astro.props;
const config = getSiteConfig();
const email = config.socials.email;
const culture = [
  {
    title: 'Rigorous Research',
    desc: 'We pursue high-impact research with scientific rigor and intellectual honesty.',
  },
  {
    title: 'Collaborative Spirit',
    desc: 'We believe the best research comes from diverse perspectives and open collaboration.',
  },
  {
    title: 'Growth & Mentorship',
    desc: 'We invest in the development of every team member through mentorship and support.',
  },
];
---

<Layout
  title={personal ? 'Prospective Students' : 'Join Us'}
  description={personal
    ? 'Interested in working with me? See open positions and opportunities.'
    : 'Open positions and opportunities to join our research lab.'}
>
  <div class="ed-wrap ed-main ed-main--narrow">
    <div class="ed-stack">
      <h1 class="ed-h1">{personal ? 'Prospective Students' : 'Join Our Lab'}</h1>
      <p class="ed-intro">
        {
          personal
            ? "Interested in working with me? I'm always looking for talented and motivated students and collaborators."
            : "We're always looking for talented and motivated researchers to join our team."
        }
      </p>
    </div>

    <section class="ed-tl-section" aria-labelledby="join-culture">
      <h2 id="join-culture" class="ed-label ed-tl-group">{personal ? 'Working With Me' : 'Our Culture'}</h2>
      <div class="ed-cards">
        {
          culture.map((item) => (
            <div class="ed-card">
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="ed-tl-section" aria-labelledby="join-positions">
      <h2 id="join-positions" class="ed-label ed-tl-group">Open Positions</h2>
      <p>
        {
          personal
            ? 'I have several open positions for students and researchers at various levels.'
            : 'We have several open positions for researchers at various levels.'
        }
      </p>
      <a href="/positions" class="ul ed-more">View all positions and apply <span class="arr">→</span></a>
    </section>

    <section class="ed-tl-section" aria-labelledby="join-apply">
      <h2 id="join-apply" class="ed-label ed-tl-group">How to Apply</h2>
      <p>
        {personal ? 'To apply, please visit the' : 'To apply for a position in our lab, please visit the'}{' '}
        <a href="/positions" class="ul">positions page</a>{' '}
        and use the application form on the relevant position{
          email ? (
            <>
              , or send the following materials to <ObfuscatedEmail email={email} class="ul" />:
            </>
          ) : (
            '. Please include:'
          )
        }
      </p>
      <ol class="ed-tl-steps">
        <li>Your CV/resume</li>
        <li>A brief statement of research interests (1-2 paragraphs)</li>
        <li>Relevant publications or writing samples (if available)</li>
        <li>Names and contact information for 2-3 references</li>
      </ol>
      <p class="ed-tl-fine">
        Please use the subject line: <code class="ed-tl-code">[Position Type] Application - Your Name</code>
      </p>
    </section>
  </div>
</Layout>
