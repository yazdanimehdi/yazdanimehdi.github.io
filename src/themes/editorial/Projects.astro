---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import { getSiteConfig } from '../../lib/config';
import { resolveImage } from '../../lib/content/image';
import { isInkArt } from '../../lib/inkArt';
import './projects.css';

interface Props {
  /** Already in display order (active, upcoming, completed). */
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const config = getSiteConfig();
const personal = config.siteMode === 'personal';
const description = personal
  ? 'My research projects, tools, and datasets.'
  : 'Our research projects, tools, and datasets.';
const intro = personal
  ? 'My research projects, open-source tools, and datasets.'
  : 'Explore our research projects, open-source tools, and datasets.';

const cards = await Promise.all(
  projects.map(async (p) => {
    const image = p.data.image;
    return {
      id: p.id,
      data: p.data,
      cover: image ? (await resolveImage(image, 720)).src : undefined,
      ink: await isInkArt(image),
      size: image && typeof image !== 'string' ? { width: image.width, height: image.height } : {},
      links: [
        { label: 'Website', href: p.data.url },
        { label: 'Code', href: p.data.repoUrl },
        { label: 'Paper', href: p.data.paperUrl },
      ].filter((l) => l.href),
    };
  }),
);

const GROUPS = [
  { status: 'active', title: 'Active' },
  { status: 'upcoming', title: 'Upcoming' },
  { status: 'completed', title: 'Completed' },
] as const;
const groups = GROUPS.map((g) => ({ ...g, cards: cards.filter((c) => c.data.status === g.status) })).filter(
  (g) => g.cards.length > 0,
);
---

<Layout title="Projects" description={description}>
  <div class="ed-wrap ed-main">
    <div class="ed-stack">
      <h1 class="ed-h1">Projects</h1>
      <p class="ed-intro">{intro}</p>
    </div>

    {cards.length === 0 && <p class="ed-pj-empty">No projects yet.</p>}

    {
      groups.map((g) => (
        <section class="ed-pj-group" aria-labelledby={`pj-${g.status}`}>
          <h2 id={`pj-${g.status}`} class="ed-label ed-pj-group-head">
            {g.title}
          </h2>
          <div class="ed-pj-grid">
            {g.cards.map((c, i) => (
              <article class="ed-pj-card">
                {c.cover && (
                  <a href={`/projects/${c.id}`} class="ed-pj-cover" tabindex="-1" aria-hidden="true">
                    <img
                      src={c.cover}
                      alt=""
                      {...c.size}
                      class:list={[c.ink && 'ed-ink']}
                      loading={i < 2 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </a>
                )}
                <h3 class="ed-pj-title">
                  <a href={`/projects/${c.id}`}>{c.data.title}</a>
                </h3>
                <div class="ed-pj-notes">
                  <span class="ed-note">{c.data.type}</span>
                  <span class="ed-note">{c.data.status}</span>
                </div>
                {c.data.excerpt && <p class="ed-pj-desc">{c.data.excerpt}</p>}
                {c.data.tags && c.data.tags.length > 0 && <p class="ed-pj-tags">{c.data.tags.join(' · ')}</p>}
                {c.links.length > 0 && (
                  <div class="ed-pj-links">
                    {c.links.map((l) => (
                      <a href={l.href} class="ul" rel="noopener noreferrer">
                        {l.label}{' '}
                        <span class="arr" aria-hidden="true">
                          ↗
                        </span>
                      </a>
                    ))}
                  </div>
                )}
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Layout>
