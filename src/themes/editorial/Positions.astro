---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import { formatNewsDate } from '../../lib/utils';
import './timeline.css';

interface Props {
  personal: boolean;
  /** Already sorted: open first, then by sortOrder. */
  positions: CollectionEntry<'positions'>[];
  formatType: (type: string) => string;
}

const { personal, positions, formatType } = Astro.props;
const title = personal ? 'Prospective Students & Opportunities' : 'Open Positions';
const open = positions.filter((p) => p.data.status === 'open');
const closed = positions.filter((p) => p.data.status !== 'open');
---

<Layout
  title={title}
  description={personal
    ? 'Opportunities to work with me.'
    : 'Open positions and opportunities to join our research lab.'}
>
  <div class="ed-wrap ed-main ed-main--narrow">
    <div class="ed-stack">
      <h1 class="ed-h1">{title}</h1>
      <p class="ed-intro">
        {
          personal
            ? 'Current openings and opportunities to work with me.'
            : 'Current openings and opportunities to join our research lab.'
        }
      </p>
    </div>

    {
      positions.length === 0 ? (
        <p class="ed-tl-empty">No positions are currently listed. Please check back later.</p>
      ) : open.length === 0 ? (
        <p class="ed-tl-empty">No positions are open right now. Please check back later.</p>
      ) : (
        <ol class="ed-tl-list">
          {open.map((p) => (
            <li class="row ed-tl-row">
              <div class="ed-tl-body">
                <div class="ed-tl-titleline">
                  <a href={`/positions/${p.id}`} class="ed-tl-title">
                    {p.data.title}
                  </a>
                  <span class="ed-note">{formatType(p.data.type)}</span>
                </div>
                {p.data.excerpt && <p class="ed-tl-excerpt">{p.data.excerpt}</p>}
                <div class="ed-tl-meta">
                  {p.data.deadline && (
                    <span class="ed-tl-deadline">
                      <span class="ed-label">Deadline</span>
                      <time class="num" datetime={p.data.deadline.toISOString()}>
                        {formatNewsDate(p.data.deadline, 'day')}
                      </time>
                    </span>
                  )}
                  {p.data.tags && p.data.tags.length > 0 && <span>{p.data.tags.join(' · ')}</span>}
                  <a href={`/positions/${p.id}`} class="ul ed-tl-more" aria-label={`Details: ${p.data.title}`}>
                    Details <span class="arr">→</span>
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ol>
      )
    }

    {
      closed.length > 0 && (
        <section class="ed-tl-closed" aria-labelledby="positions-closed">
          <h2 id="positions-closed" class="ed-label ed-tl-group">
            Closed
          </h2>
          <ol class="ed-tl-list">
            {closed.map((p) => (
              <li class="row ed-tl-row">
                <div class="ed-tl-body">
                  <div class="ed-tl-titleline">
                    <a href={`/positions/${p.id}`} class="ed-tl-title">
                      {p.data.title}
                    </a>
                    <span class="ed-tl-meta">{formatType(p.data.type)}</span>
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </div>
</Layout>
