---
/*
 * Light / dark / system. The half-filled disc turns to show the mode: right half (light), left half (dark),
 * lower half (system), where the word "system" also shows beside the disc, so the state never rests on the
 * icon alone. DarkModeScript applies the stored choice before paint; this changes it, and makes a
 * stored "system" follow prefers-color-scheme even when the site default is light or dark.
 */
import { getSiteConfig } from '../../lib/config';
import { uiStrings } from '../../lib/ui-strings';

const config = getSiteConfig();
const t = uiStrings(config);
const defaultMode = config.defaultTheme ?? 'system';
const words = { light: t('mode.light'), dark: t('mode.dark'), system: t('mode.system') };
const label = t('mode.label', { mode: t('mode.default', { mode: words[defaultMode] }) });
const strings = JSON.stringify({ label: t('mode.label'), byDefault: t('mode.default'), words });
---

<button
  type="button"
  class="ed-mode"
  data-mode-toggle
  data-mode={defaultMode}
  data-strings={strings}
  aria-label={label}
  title={label}
>
  <span class="ed-mode-word" aria-hidden="true">{words.system}</span>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path class="ed-mode-half" d="M12 3.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor"></path>
  </svg>
</button>

<script is:inline>
  (() => {
    if (window.__edModeToggle) return;
    window.__edModeToggle = true;
    const MODES = ['light', 'dark', 'system'];
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const root = document.documentElement;
    const stored = () => {
      try {
        const saved = localStorage.getItem('theme');
        return MODES.includes(saved) ? saved : null;
      } catch {
        return null;
      }
    };
    const siteDefault = () => {
      const d = root.getAttribute('data-default-theme');
      return MODES.includes(d) ? d : 'system';
    };
    const isDark = (mode) => mode === 'dark' || (mode === 'system' && media.matches);
    const apply = () => {
      const choice = stored();
      const mode = choice ?? siteDefault();
      root.classList.toggle('dark', isDark(mode));
      for (const button of document.querySelectorAll('[data-mode-toggle]')) {
        const s = JSON.parse(button.dataset.strings);
        const word = s.words[mode];
        const label = s.label.replace('{mode}', choice ? word : s.byDefault.replace('{mode}', word));
        button.dataset.mode = mode;
        button.setAttribute('aria-label', label);
        button.setAttribute('title', label);
      }
    };
    // nextColorMode in src/lib/utils.ts, inlined (this script is not bundled): every click flips the page.
    // The OS preference, then its opposite, then system; leaving system goes to the opposite of what it shows.
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('[data-mode-toggle]')) return;
      const os = media.matches ? 'dark' : 'light';
      const flip = os === 'dark' ? 'light' : 'dark';
      const order = [os, flip, 'system'];
      const current = stored() ?? (isDark(siteDefault()) ? 'dark' : 'light');
      const next = current === 'system' ? flip : order[(order.indexOf(current) + 1) % order.length];
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage blocked: the change still applies to this page */
      }
      apply();
    });
    media.addEventListener('change', apply);
    // DarkModeScript re-applies after each client-side swap and reads a stored "system" as the site default.
    document.addEventListener('astro:after-swap', apply);
    document.addEventListener('astro:page-load', apply);
    apply();
  })();
</script>
