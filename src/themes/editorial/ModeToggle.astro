---
/*
 * Light / dark / system. The half-filled disc turns to show the mode: right half (light), left half (dark),
 * lower half (system). DarkModeScript applies the stored choice before paint; this only changes it.
 */
---

<button type="button" class="ed-mode" data-mode-toggle aria-label="Color theme: system" title="Color theme: system">
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path class="ed-mode-half" d="M12 3.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor"></path>
  </svg>
</button>

<script is:inline>
  (() => {
    if (window.__edModeToggle) return;
    window.__edModeToggle = true;
    const ORDER = ['light', 'dark', 'system'];
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const stored = () => {
      try {
        return localStorage.getItem('theme');
      } catch {
        return null;
      }
    };
    const mode = () => {
      const saved = stored();
      return saved === 'light' || saved === 'dark' ? saved : 'system';
    };
    const apply = () => {
      const m = mode();
      const fallback = document.documentElement.getAttribute('data-default-theme') || 'system';
      const want = m === 'system' ? fallback : m;
      const dark = want === 'dark' || (want === 'system' && media.matches);
      document.documentElement.classList.toggle('dark', dark);
      for (const button of document.querySelectorAll('[data-mode-toggle]')) {
        const label = `Color theme: ${m}`;
        button.dataset.mode = m;
        button.setAttribute('aria-label', label);
        button.setAttribute('title', label);
      }
    };
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('[data-mode-toggle]')) return;
      const next = ORDER[(ORDER.indexOf(mode()) + 1) % ORDER.length];
      try {
        if (next === 'system') localStorage.removeItem('theme');
        else localStorage.setItem('theme', next);
      } catch {
        /* storage blocked: the change still applies to this page */
      }
      apply();
    });
    media.addEventListener('change', () => mode() === 'system' && apply());
    document.addEventListener('astro:page-load', apply);
    apply();
  })();
</script>
