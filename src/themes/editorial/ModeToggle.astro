---
/*
 * Light / dark. The half-filled disc turns to show what is on screen: right half (light), left half (dark).
 * DarkModeScript applies the stored choice before paint; this flips it. With no choice stored, the site
 * default applies, and a default of "system" follows prefers-color-scheme.
 */
import { getSiteConfig } from '../../lib/config';
import { uiStrings } from '../../lib/ui-strings';

const config = getSiteConfig();
const t = uiStrings(config);
const defaultMode = config.defaultTheme ?? 'system';
const words = { light: t('mode.light'), dark: t('mode.dark') };
const shown = defaultMode === 'dark' ? 'dark' : 'light';
const label = t('mode.label', { mode: t('mode.default', { mode: words[shown] }) });
const strings = JSON.stringify({ label: t('mode.label'), byDefault: t('mode.default'), words });
---

<button
  type="button"
  class="ed-mode"
  data-mode-toggle
  data-mode={shown}
  data-strings={strings}
  aria-label={label}
  title={label}
>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path class="ed-mode-half" d="M12 3.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor"></path>
  </svg>
</button>

<script is:inline>
  (() => {
    if (window.__edModeToggle) return;
    window.__edModeToggle = true;
    const MODES = ['light', 'dark', 'system'];
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const root = document.documentElement;
    const stored = () => {
      try {
        const saved = localStorage.getItem('theme');
        return MODES.includes(saved) ? saved : null;
      } catch {
        return null;
      }
    };
    const siteDefault = () => {
      const d = root.getAttribute('data-default-theme');
      return MODES.includes(d) ? d : 'system';
    };
    const apply = () => {
      const choice = stored();
      const preferred = choice ?? siteDefault();
      const dark = preferred === 'dark' || (preferred === 'system' && media.matches);
      root.classList.toggle('dark', dark);
      const mode = dark ? 'dark' : 'light';
      for (const button of document.querySelectorAll('[data-mode-toggle]')) {
        const s = JSON.parse(button.dataset.strings);
        const word = s.words[mode];
        const label = s.label.replace('{mode}', choice ? word : s.byDefault.replace('{mode}', word));
        button.dataset.mode = mode;
        button.setAttribute('aria-label', label);
        button.setAttribute('title', label);
      }
    };
    // Every click flips what is on screen.
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('[data-mode-toggle]')) return;
      const next = root.classList.contains('dark') ? 'light' : 'dark';
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage blocked: the change still applies to this page */
      }
      apply();
    });
    media.addEventListener('change', apply);
    // DarkModeScript re-applies after each client-side swap and reads a stored "system" as the site default.
    document.addEventListener('astro:after-swap', apply);
    document.addEventListener('astro:page-load', apply);
    apply();
  })();
</script>
