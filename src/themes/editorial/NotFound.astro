---
import Layout from './Layout.astro';
import './projects.css';

const links = [
  { label: 'Home', href: '/' },
  { label: 'Publications', href: '/publications' },
  { label: 'Blog', href: '/blog' },
];
---

<Layout title="Page Not Found">
  <div class="ed-wrap ed-main ed-main--narrow">
    <div class="ed-stack">
      <h1 class="ed-h1">Page not found</h1>
      <p class="ed-intro">The page you're looking for doesn't exist or has been moved.</p>
    </div>
    <nav class="ed-pj-links ed-pj-links--lg" aria-label="Where to next">
      {
        links.map((l) => (
          <a href={l.href} class="ul">
            {l.label}{' '}
            <span class="arr" aria-hidden="true">
              →
            </span>
          </a>
        ))
      }
    </nav>
  </div>
</Layout>
