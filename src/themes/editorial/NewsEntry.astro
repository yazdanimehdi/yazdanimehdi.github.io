---
import type { CollectionEntry } from 'astro:content';
import EntryBody from '../../components/astro/EntryBody.astro';
import ProseEnhancements from '../../components/astro/ProseEnhancements.astro';
import Layout from './Layout.astro';
import { getSiteConfig } from '../../lib/config';
import { getEntries } from '../../lib/content';
import { resolveImage } from '../../lib/content/image';
import { imageFacts } from '../../lib/inkArt';
import { formatNewsDate } from '../../lib/utils';
import './timeline.css';

interface Props {
  entry: CollectionEntry<'announcements'>;
  ogImage?: string;
}

const { entry, ogImage } = Astro.props;
const label = getSiteConfig().nav.find((n) => n.href === '/news')?.label ?? 'News';
const cover = entry.data.image;
const facts = await imageFacts(cover);
const coverSrc = cover ? (await resolveImage(cover, 1360)).src : undefined;
const coverSize = cover && typeof cover !== 'string' ? { width: cover.width, height: cover.height } : facts;

const ids = entry.data.people ?? [];
const people = ids.length ? (await getEntries('people')).filter((p) => ids.includes(p.id)) : [];
people.sort((a, b) => ids.indexOf(a.id) - ids.indexOf(b.id));
---

<Layout title={entry.data.title} description={entry.data.excerpt} ogImage={ogImage}>
  <article class="ed-article">
    <a href="/news" class="ed-back">← {label}</a>
    <header class="ed-article-head">
      <h1 class="ed-article-title">{entry.data.title}</h1>
      {entry.data.excerpt && <p class="ed-subtitle">{entry.data.excerpt}</p>}
      <span class="ed-byline num">
        {entry.data.category && <span class="ed-meta-cap">{entry.data.category} · </span>}
        <time datetime={entry.data.date.toISOString()}>
          {formatNewsDate(entry.data.date, entry.data.datePrecision)}
        </time>
      </span>
    </header>

    {
      coverSrc && (
        <figure class="ed-cover ed-figure-box">
          <img
            src={coverSrc}
            alt=""
            width={coverSize.width}
            height={coverSize.height}
            class:list={[facts.ink && 'ed-ink']}
            decoding="async"
          />
        </figure>
      )
    }

    <div class="ed-prose"><EntryBody entry={entry} /></div>
    <ProseEnhancements />

    {
      people.length > 0 && (
        <aside class="ed-tl-people" aria-labelledby="news-people">
          <span id="news-people" class="ed-label">
            People
          </span>
          <ul>
            {people.map((p) => (
              <li>
                <a href={`/people/${p.id}`} class="ul">
                  {p.data.name}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </article>
</Layout>
