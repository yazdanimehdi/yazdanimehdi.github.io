---
import EntryBody from '../../components/astro/EntryBody.astro';
import Layout from './Layout.astro';
import SEO from '../../components/astro/SEO.astro';
import ProseEnhancements from '../../components/astro/ProseEnhancements.astro';
import { paperLink } from '../../lib/editorial';
import { formatNewsDate } from '../../lib/utils';
import { uiStrings } from '../../lib/ui-strings';
import { COVER_SIZES, resolveCover } from '../../lib/content/image';
import { isInkArt } from '../../lib/inkArt';
import type { PostData } from './data';

type Props = PostData & { ogImage?: string };

const { config, post, author, minutes, related, newer, older, ogImage } = Astro.props;
const t = uiStrings(config);
const label = config.nav.find((n) => n.href === '/blog')?.label ?? t('home.writing');
const tags = post.data.tags ?? [];
const cover = post.data.coverImage;
const coverImg = cover ? await resolveCover(cover) : undefined;
const coverInk = await isInkArt(cover);
---

<Layout title={post.data.title} description={post.data.excerpt} ogImage={ogImage} keywords={post.data.keywords}>
  <SEO
    type="blogPost"
    title={post.data.title}
    description={post.data.excerpt}
    datePublished={post.data.date}
    author={post.data.author}
    keywords={post.data.keywords}
  />
  <article class="ed-article">
    <a href="/blog" class="ed-back">
      <span class="arr" aria-hidden="true">
        ←
      </span>{' '}
      {label}
    </a>
    <header class="ed-article-head">
      <h1 class="ed-article-title" dir="auto">
        {post.data.title}
      </h1>
      {post.data.subtitle && (
        <p class="ed-subtitle" dir="auto">
          {post.data.subtitle}
        </p>
      )}
      <span class="ed-byline">
        <span dir="auto">{author}</span> ·{' '}
        <time datetime={post.data.date.toISOString()}>{formatNewsDate(post.data.date, 'day', config.lang)}</time> ·{' '}
        {t('post.minutes', { n: minutes })}
        {tags.length > 0 && (
          <>
            {' · '}
            <span dir="auto">{tags.join(', ')}</span>
          </>
        )}
      </span>
    </header>

    {coverImg && (
      <figure class="ed-cover ed-figure-box">
        <img
          src={coverImg.src}
          srcset={coverImg.srcset}
          sizes={COVER_SIZES}
          alt=""
          width={coverImg.width}
          height={coverImg.height}
          class:list={[coverInk && 'ed-ink']}
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    )}

    <div class="ed-prose" dir="auto">
      <EntryBody entry={post} />
    </div>
    <ProseEnhancements />

    {related && (
      <div class="ed-aside">
        <span class="ed-aside-label">{t('post.relatedPaper')}</span>
        <a href={paperLink(related.data) ?? `/publications#${related.id}`} dir="auto">
          {related.data.title}
        </a>
        <span class="ed-aside-venue" dir="auto">
          {related.data.venue}
        </span>
      </div>
    )}

    {(older || newer) && (
      <nav class="ed-pager" aria-label={t('post.morePosts')}>
        {older ? (
          <a href={`/blog/${older.id}`}>
            <span class="arr" aria-hidden="true">
              ←
            </span>{' '}
            <span dir="auto">{older.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {newer && (
          <a href={`/blog/${newer.id}`}>
            <span dir="auto">{newer.data.title}</span>{' '}
            <span class="arr" aria-hidden="true">
              →
            </span>
          </a>
        )}
      </nav>
    )}
  </article>
</Layout>
