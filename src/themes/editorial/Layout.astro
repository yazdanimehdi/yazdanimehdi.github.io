---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteConfig, getSiteName } from '../../lib/config';
import { headerLogo } from '../../lib/content/image';
import { socialLinks, splitNav } from '../../lib/editorial';
import { uiStrings } from '../../lib/ui-strings';
import type { NavItem } from '../../lib/types';
import ModeToggle from './ModeToggle.astro';
import FooterNav from './FooterNav.astro';
import './editorial.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  keywords?: string;
  /** Dark "get in touch" footer (home page) instead of the light one. */
  contactFooter?: boolean;
}

const { title, description, ogImage, keywords, contactFooter = false } = Astro.props;
const config = getSiteConfig();
const name = getSiteName();
const logo = config.logo ? await headerLogo(config.logo) : null;
const email = config.socials?.email;
const links = socialLinks(config.socials);
// `links`: optional onward links in the home contact band (e.g. a prospective-students page).
const contact = config.editorial?.contact as { heading?: string; text?: string; links?: NavItem[] } | undefined;
const nav = splitNav(config.nav, config.siteMode, Astro.url.pathname);
const t = uiStrings(config);
const year = new Date().getFullYear();
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<BaseLayout title={title} description={description} ogImage={ogImage} keywords={keywords}>
  <header class="ed-header">
    <nav class="ed-wrap ed-nav" aria-label={t('nav.primary')}>
      <a href="/" class="ed-brand">
        {logo ? (
          <img
            src={logo.src}
            alt=""
            width={logo.width}
            height="28"
            class:list={['ed-brand-logo', logo.ink && 'ed-ink']}
          />
        ) : (
          <span class="ed-brand-mark" aria-hidden="true" />
        )}
        <span class="ed-brand-name" dir="auto">
          {name}
        </span>
      </a>
      <div class="ed-navlinks">
        {nav.primary.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </div>
      {nav.contact && (
        <span class="ed-nav-contact">
          <a href={nav.contact.href} aria-current={isActive(nav.contact.href) ? 'page' : undefined}>
            {nav.contact.label}
          </a>
        </span>
      )}
      <ModeToggle />
    </nav>
  </header>

  <script is:inline>
    (() => {
      // Phones scroll the nav row sideways: keep the current page's link in view, and fade the row's
      // trailing edge only while links remain past it.
      const row = document.querySelector('.ed-navlinks');
      if (!row) return;
      row.querySelector('[aria-current]')?.scrollIntoView({ block: 'nearest', inline: 'center' });
      const fade = () =>
        row.toggleAttribute('data-more', row.scrollWidth - row.clientWidth - Math.abs(row.scrollLeft) > 1);
      fade();
      row.addEventListener('scroll', fade, { passive: true });
      new ResizeObserver(fade).observe(row);
    })();
  </script>
  <main id="main-content" class="ed-grow">
    <slot />
  </main>

  {contactFooter ? (
    <footer class="ed-contact">
      <div class="ed-wrap ed-contact-inner">
        <div class="ed-contact-top">
          <div class="ed-contact-copy">
            <h2 dir="auto">{contact?.heading || t('contact.heading')}</h2>
            {contact?.text && <p dir="auto">{contact.text}</p>}
            {contact?.links?.length ? (
              <p class="ed-contact-onward">
                {contact.links.map((l) => (
                  <a class="ul" href={l.href}>
                    {l.label} <span class="arr">→</span>
                  </a>
                ))}
              </p>
            ) : null}
          </div>
          {email && (
            <a class="ed-btn-light" href={`mailto:${email}`}>
              {email}
            </a>
          )}
        </div>
        <div class="ed-contact-bottom">
          <span>
            © <span class="num">{year}</span> <bdi>{name}</bdi>
          </span>
          {nav.more.length > 0 && <FooterNav items={nav.more} label={t('nav.more')} {isActive} />}
          {links.length > 0 && (
            <span class="ed-contact-links">
              {links.map((l) => (
                <a class="ul" href={l.href}>
                  {l.label}
                </a>
              ))}
            </span>
          )}
        </div>
      </div>
    </footer>
  ) : (
    <footer class="ed-footer">
      <div class="ed-wrap ed-footer-inner">
        <span>
          © <span class="num">{year}</span> <bdi>{name}</bdi>
        </span>
        {nav.more.length > 0 && <FooterNav items={nav.more} label={t('nav.more')} {isActive} />}
        {email && (
          <a class="ul" href={`mailto:${email}`}>
            {email}
          </a>
        )}
      </div>
    </footer>
  )}
</BaseLayout>
