---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import { getSiteConfig } from '../../lib/config';
import { formatNewsDate, readingTime } from '../../lib/utils';

interface Props {
  tag: string;
  /** Newest first. */
  posts: CollectionEntry<'posts'>[];
}

const { tag, posts } = Astro.props;
const label = getSiteConfig().nav.find((n) => n.href === '/blog')?.label ?? 'Writing';
const count = `${posts.length} post${posts.length !== 1 ? 's' : ''}`;
---

<Layout title={`Posts tagged "${tag}"`} description={`Blog posts tagged with "${tag}".`}>
  <div class="ed-wrap ed-main ed-main--narrow">
    <a href="/blog" class="ed-back">← {label}</a>
    <div class="ed-stack">
      <h1 class="ed-h1">Posts tagged “{tag}”</h1>
      <p class="ed-intro"><span class="num">{count}</span> tagged with “{tag}”.</p>
    </div>

    <ol class="ed-entries">
      {
        posts.map((post) => {
          const date = formatNewsDate(post.data.date, 'month');
          const meta = `${date} · ${readingTime(post.body ?? '')} min read`;
          return (
            <li class="ed-entry">
              <div class="ed-entry-tile" aria-hidden="true">
                <span class="ed-entry-tag">{tag}</span>
                <span class="ed-entry-date num">{date}</span>
              </div>
              <div class="ed-entry-body">
                <a href={`/blog/${post.id}`} class="ed-entry-title">
                  {post.data.title}
                </a>
                {post.data.excerpt && <p class="ed-entry-excerpt">{post.data.excerpt}</p>}
                <span class="ed-entry-meta num">{meta}</span>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</Layout>
