# Custom admin on Vercel. See README → "Deploy on Vercel (custom admin)". Never commit real values.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=
# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Optional: default to the repository and branch Vercel deploys
GITHUB_REPO=
GITHUB_BRANCH=

# Postgres mode (README → "Postgres mode"). Set by the Neon and Vercel Blob integrations:
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# At least 32 random characters; Vercel Cron sends it as `Authorization: Bearer …`
CRON_SECRET=

# Optional: "Also publish to Medium" sends drafts through Medium's API (Medium no longer issues new tokens;
# existing integration tokens work). Without it the admin uses Medium's import tool.
MEDIUM_TOKEN=

# Local development in Postgres mode (`pnpm dev:postgres`): the connection string of a Neon `dev` branch.
# The DATABASE_URL that `vercel env pull` writes is production and is never used locally.
DEV_DATABASE_URL=
