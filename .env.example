# Custom admin on Vercel. See README → "Deploy on Vercel (custom admin)". Never commit real values.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=
# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Optional: default to the repository and branch Vercel deploys
GITHUB_REPO=
GITHUB_BRANCH=

# Postgres mode (README → "Postgres mode"). Set by the Neon and Vercel Blob integrations:
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# At least 32 random characters; Vercel Cron sends it as `Authorization: Bearer …`
CRON_SECRET=
# The first admin account, created by the build while none exists (12+ characters). Username: ADMIN_USERNAME,
# else the GitHub owner of the deployed repository. Used once; change the password in the admin afterwards.
ADMIN_PASSWORD=
ADMIN_USERNAME=

# Optional: "Also publish to Medium" sends drafts through Medium's API (Medium no longer issues new tokens;
# existing integration tokens work). Without it the admin uses Medium's import tool.
MEDIUM_TOKEN=

# Optional: AI assist (README → "AI assist"). In Postgres mode you can enter these on the admin's AI screen instead,
# where they are stored encrypted; these variables are the fallback.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Google Scholar papers through SerpApi's Google Scholar Author API
SERPAPI_KEY=

# Site editor (README → "Site editor"): on Vercel the sandbox signs in by itself (OIDC). For `pnpm dev`, run
# `vercel link` and `vercel env pull` to get a VERCEL_OIDC_TOKEN (it expires after about 12 hours; pull again).
# It also needs GITHUB_TOKEN above and the writing provider's key.
VERCEL_OIDC_TOKEN=

# Local development in Postgres mode (`pnpm dev:postgres`): the connection string of a Neon `dev` branch.
# The DATABASE_URL that `vercel env pull` writes is production and is never used locally.
DEV_DATABASE_URL=
