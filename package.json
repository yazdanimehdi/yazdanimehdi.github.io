{
  "name": "academic-website-template",
  "type": "module",
  "version": "1.0.0",
  "description": "A forkable academic/lab website template built with Astro, Vue, and Tailwind CSS",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "dev:postgres": "tsx scripts/dev-postgres.ts",
    "start": "astro dev",
    "build": "astro build",
    "vercel-build": "tsx scripts/vercel-bootstrap.ts && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sync:feeds": "tsx scripts/sync-feeds.ts",
    "sync:github": "tsx scripts/sync-github.ts",
    "due:posts": "tsx scripts/due-posts.ts",
    "sync:scholar": "python3 scripts/sync-scholar.py",
    "render:cv": "python3 scripts/render-cv.py",
    "generate:keywords": "tsx scripts/generate-seo-keywords.ts",
    "migrate:al-folio": "tsx scripts/migrate-al-folio.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:export": "tsx scripts/db-export.ts",
    "admin:create-user": "tsx scripts/admin-create-user.ts",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "format": "prettier --write .",
    "check": "astro check",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "check:themes": "node scripts/check-themes.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.16",
    "@astrojs/vue": "^7.1.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-mathematics": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.1",
    "@vercel/sandbox": "3.7.0",
    "astro": "^7.4.1",
    "ffmpeg-static": "^5.3.0",
    "gsap": "^3.15.0",
    "hast-util-from-html": "^2.0.3",
    "katex": "^0.18.11",
    "postgres": "^3.4.9",
    "remark-math": "^6.0.0",
    "rss-parser": "^3.13.0",
    "unist-util-visit": "^5.1.0",
    "vue": "^3.5.44",
    "workflow": "5.2.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.9",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "js-yaml": "^4.3.2",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "ffmpeg-static"
    ]
  }
}
